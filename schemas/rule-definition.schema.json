{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/ap9.3.1-rule-definition.schema.json",
  "title": "AP9.3.1 Rule Definition",
  "type": "object",
  "required": [
    "rule_id",
    "version",
    "title",
    "description",
    "rationale",
    "category",
    "severity",
    "scope",
    "enabled_by_default"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "category": {
      "enum": [
        "semantic",
        "structural",
        "governance",
        "quality",
        "layout",
        "release"
      ]
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "error",
        "critical"
      ]
    },
    "scope": {
      "enum": [
        "repository",
        "object",
        "flow",
        "graph"
      ]
    },
    "enabled_by_default": {
      "type": "boolean"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}